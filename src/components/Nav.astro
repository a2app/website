---
import BrandMark from './BrandMark.astro';

// Home-page sections first, in the order a visitor scrolls past them, then
// anything that lives on another page, then the outbound link.
const links = [
  { href: '/#how-it-works', label: 'How It Works' },
  { href: '/#features', label: 'Features' },
  { href: '/#demo', label: 'Live Demo' },
  { href: '/#devices', label: 'Cross-Device' },
  { href: '/#usecases', label: 'Use Cases' },
  { href: '/#aosf', label: 'AOSF' },
  { href: '/#factory', label: 'Factory' },
  { href: '/#vision', label: 'Why Now' },
  { href: '/demos#showcase', label: 'Showcase' },
];
---
<nav class="nav" aria-label="Primary">
  <a href="/" class="nav-logo"><BrandMark />A2App</a>
  <div class="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="https://makepad.nl" target="_blank" rel="noopener" class="nav-cta">Makepad 2.0 →</a>
  </div>
  <button class="mobile-menu" type="button" aria-label="Toggle menu" aria-expanded="false">☰</button>
</nav>
