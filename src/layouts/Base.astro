---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'A2App — Agent to App',
  description = "AI agents don't just chat anymore — they build entire apps.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Brand assets: regenerate with `npm run brand` (see brand/README.md) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#06070A" />
    <meta name="apple-mobile-web-app-title" content="A2App" />

    <!-- Social preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://a2app.ai/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://a2app.ai/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://a2app.ai/og-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="vig" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>
    <div class="halo" id="halo" aria-hidden="true"></div>
    <div class="progress" id="prog" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
