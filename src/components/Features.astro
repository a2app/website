---
const features = [
  { tag: 'Security', tone: 'tag-mint', title: 'Declarative, Not Executable', body: 'Agents send structured component descriptions — never raw code. No injection attacks, no sandbox escapes. Your catalog controls what\'s allowed.' },
  { tag: 'Streaming', tone: 'tag-indigo', title: 'Progressive Rendering', body: 'UIs build in real-time as the agent generates them. Users see the interface materializing — no waiting for complete responses.' },
  { tag: 'Universal', tone: 'tag-pink', title: 'One Response, Every Platform', body: 'A single agent output renders natively on web, iOS, Android, and desktop. Your design system, your components, every device.' },
  { tag: 'Interactive', tone: 'tag-amber', title: 'Two-Way Communication', body: 'Users interact with generated UIs — fill forms, click buttons, manipulate data — and actions flow back to the agent for dynamic responses.' },
];
---
<section class="sec" id="features">
  <div class="wrap">
    <div class="eyebrow" data-reveal>Core Capabilities</div>
    <h2 data-reveal data-delay=".08">Not just chat. <br />Full applications.</h2>
    <p class="lede" data-reveal data-delay=".16">Running on Makepad 2.0, A2App turns AI agents into app generators — secure, declarative, and universal.</p>
    <div class="features-grid">
      {features.map((f, i) => (
        <div class="card feature-card" data-reveal data-delay={String(.2 + i * .06)}>
          <span class={`tag ${f.tone}`}>{f.tag}</span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
