---
// One prompt and what it produces: the real Makepad data grid, opened on its
// charts tab, running in place. No code on this page: the point of A2App is that a plain request is
// the whole interface. The full set of demos lives on /demos.
import DemoEmbed from './DemoEmbed.astro';
import demos from '../data/demos.json';
const demo = demos.find((d) => d.id === 'datagrid')!;
const points = ['Real-time data binding from your APIs', 'Interactive charts with drill-down', 'Responsive layouts across devices'];
---
<section class="sec" id="demo">
  <div class="wrap">
    <div class="eyebrow" data-reveal>See It Work</div>
    <h2 data-reveal data-delay=".08">From prompt to app, <br />in seconds.</h2>
    <p class="lede" data-reveal data-delay=".16">Watch an AI agent transform a simple request into a fully interactive application.</p>

    <div class="demo-wrapper" data-reveal data-delay=".24">
      <div class="demo-content">
        <div class="demo-visual">
          <div class="demo-bubble user">Build me a sales analytics dashboard with charts and KPIs</div>
          <div class="demo-bubble agent">Generating your dashboard with 4 KPI cards, a revenue trend chart, and a regional breakdown table…</div>
          <DemoEmbed id={demo.id} title={demo.title} width={demo.width} height={demo.height} autostart />
        </div>
        <div class="demo-text">
          <h3>Dynamic Dashboards</h3>
          <p>Agents compose charts, KPI cards, tables, and filters into a cohesive dashboard — all from a single prompt.</p>
          <ul>{points.map((pt) => <li>{pt}</li>)}</ul>
        </div>
      </div>
    </div>
    <div class="demo-more" data-reveal>
      <a href="/demos" class="btn-primary">Open the live demos →</a>
    </div>
  </div>
</section>
